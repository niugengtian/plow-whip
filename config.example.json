{
  "projects_dir": "/absolute/path/to/projects-root",
  "agents": [
    "codex_cli",
    "cursor_cli",
    "simple-tasker"
  ],
  "agent_meta": {
    "codex_cli": {
      "role": "Planner / Code Owner",
      "roles": ["planner", "implementation", "reviewer"],
      "driver": "codex_cli"
    },
    "cursor_cli": {
      "role": "Code Owner / Reviewer",
      "roles": ["implementation", "reviewer"],
      "driver": "cursor_cli"
    },
    "simple-tasker": {
      "role": "Low-cost simple task executor",
      "roles": ["implementation"],
      "capabilities": ["simple-task"],
      "driver": "simple_tasker",
      "cost_tier": "low"
    }
  }
}
